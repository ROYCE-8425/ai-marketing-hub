# ============================================================================
# AI Marketing Hub — Biến Môi Trường (Environment Variables)
# Copy file này thành ./backend/.env rồi điền các giá trị thực tế.
# ============================================================================

# ── AI / LLM API Keys ──────────────────────────────────────────────────────
# Cần ít nhất 1 key để dùng các tính năng AI (phân tích keyword, viết nội dung...)
# Hệ thống sẽ tự chọn provider có sẵn (ưu tiên: Groq → Gemini → OpenAI)

GROQ_API_KEY=                       # Groq Cloud — miễn phí, tốc độ nhanh
GEMINI_API_KEY=                     # Google Gemini — miễn phí tier có sẵn
ZAI_API_KEY=                        # Zalo AI (tuỳ chọn)

OPENAI_API_KEY=                     # OpenAI ChatGPT (tuỳ chọn, có phí)
OPENAI_BASE_URL=https://api.openai.com/v1  # Hoặc dùng proxy tương thích
OPENAI_MODEL=gpt-3.5-turbo         # Model mặc định

# ── Google Search Console (GSC) ─────────────────────────────────────────────
# Dữ liệu keyword thực từ Google Search Console
# Xem hướng dẫn lấy token: docs/google-setup.md

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GSC_SITE_URL=                       # VD: https://yourdomain.com/

# ── Google Analytics 4 (GA4) ────────────────────────────────────────────────
# Dữ liệu traffic từ Google Analytics

GA4_PROPERTY_ID=                    # VD: 123456789
GA4_REFRESH_TOKEN=                  # Hoặc dùng chung token GSC
GA4_CREDENTIALS_PATH=               # Đường dẫn file service-account JSON (tuỳ chọn)

# ── Google Custom Search API ────────────────────────────────────────────────
# Dùng để gợi ý keyword và phân tích SERP

GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_CUSTOM_SEARCH_API_KEY=       # Alias cho Search API key
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=     # Alias cho CX

# ── DataForSEO (tuỳ chọn) ──────────────────────────────────────────────────
# Dữ liệu SERP cao cấp — có phí

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── SerpAPI (tuỳ chọn) ─────────────────────────────────────────────────────
SERPAPI_KEY=

# ── WordPress Publishing ────────────────────────────────────────────────────
# Đăng bài tự động lên WordPress (tuỳ chọn)

WP_URL=                             # VD: https://yourdomain.com
WP_USERNAME=
WP_APP_PASSWORD=                    # Application Password (không phải mật khẩu đăng nhập)

# ── Frontend (chỉ dùng khi build Docker) ────────────────────────────────────
# Nếu dùng nginx proxy: để mặc định /api
# Nếu chạy riêng frontend: http://localhost:8000/api

VITE_API_BASE_URL=/api
